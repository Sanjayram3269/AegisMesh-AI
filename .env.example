# AegisMesh AI — Environment Configuration Example

# Application Setup
APP_ENV=development
DEMO_MODE=true
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# LLM Provider Configuration (Hugging Face Router / IBM Granite)
LLM_PROVIDER=huggingface
HF_TOKEN=
HF_ROUTER_URL=https://router.huggingface.co/v1
HF_MODEL=ibm-granite/granite-7b-instruct:featherless-ai
LLM_ALLOW_MOCK_FALLBACK=true

# Database Connection
DATABASE_URL=sqlite:///./aegismesh.db

# RAG Engine Configuration
RAG_PROVIDER=local
VECTOR_STORE_PATH=./rag/vectorstore/data

# Security Controls
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Governance Policy Thresholds
MAX_AGENT_ITERATIONS=5
DEFAULT_ESCALATION_THRESHOLD=70
FAIL_CLOSED=true

# CyberForge Cryptographic Keys (HMAC)
CYBERFORGE_APPROVAL_KEY=replace_with_secure_random_key_in_production
CYBERFORGE_AUDIT_KEY=replace_with_secure_random_key_in_production

# Working operations assistant (root workspace)
# auto chooses Groq, then OpenAI, then clearly labelled offline mode.
AEGIS_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: keep durable data at a chosen local directory.
# AEGIS_DATA_DIR=.local
# Optional: initial lab passwords. Random values are generated if omitted.
# AEGIS_AGENT_PASSWORD=
# AEGIS_MANAGER_PASSWORD=
# AEGIS_AUDITOR_PASSWORD=

